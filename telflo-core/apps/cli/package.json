{
  "name": "@telflo/cli",
  "version": "0.3.0",
  "description": "The Telflo CLI: validate, test, push and deploy OpenTelemetry Collector configurations",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "bin": {
    "telflo": "dist/index.js"
  },
  "files": [
    "dist",
    "skills"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.build.json",
    "prepack": "npm run build",
    "test": "vitest run"
  },
  "dependencies": {
    "commander": "14.0.3",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@telflo/contracts": "*",
    "@telflo/tsconfig": "*",
    "@types/node": "*"
  }
}
