{
  "name": "@telflo/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts",
    "./test-database": "./src/test-database.ts"
  },
  "scripts": {
    "migrate": "tsx src/migrate.ts",
    "fixture:seeded-flows": "tsx src/write-seeded-flows-fixture.ts",
    "fixture:seeded-test-regexes": "tsx src/write-seeded-test-regexes-fixture.ts",
    "migrate:down": "node-pg-migrate down --migrations-dir migrations --database-url-var TELFLO_MIGRATION_DATABASE_URL --migration-file-language js --schema platform --migrations-schema platform --envPath ../../.env",
    "test": "vitest run"
  },
  "dependencies": {
    "kysely": "^0.27.4",
    "node-pg-migrate": "^7.7.0",
    "pg": "^8.13.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@telflo/tsconfig": "*",
    "@types/pg": "^8.11.0",
    "dotenv": "^18.0.3",
    "tsx": "^4.23.15"
  }
}
