# Database — Postgres 18 is required (uuidv7()).
# Port 55432 matches docker-compose.yml's host mapping (deliberately
# project-specific to avoid colliding with a developer's own Postgres on
# 5432). CI uses the standard 5432 instead — its service containers are
# isolated and have no native listeners to collide with, and the CI
# workflow sets its own env inline rather than reading this file.
#
# Two roles. The API connects as its own login role, which row-level security
# constrains; migrations connect as the tables' owner (the compose superuser).
# `npm run db:migrate` runs the migrations as the owner, then creates the
# API's role with this URL's password, or resets it. The API refuses to start
# as the owner or any superuser.
#
# Development only: compose uses the same telflo_platform password, because both
# share one Postgres server and provisioning resets the server-wide role's
# password.
TELFLO_DATABASE_URL=postgresql://telflo_platform:telflo-api-local@localhost:55432/telflo_platform
# Read only by `npm run db:migrate` and test setup, never by the API.
TELFLO_MIGRATION_DATABASE_URL=postgresql://telflo_platform_owner:telflo-local@localhost:55432/telflo_platform

# API
TELFLO_API_PORT=8080

# Port 53000 matches apps/web/vite.config.ts's pinned, strictPort dev server
# (Vite's own default, 5173, is not project-specific and collides easily
# with other Vite projects — see the database comment above for the same
# reasoning applied to 55432/51025/58025). Verification links are built by
# concatenating this value, so the two must agree; vite.config.ts fails
# loudly (strictPort) rather than silently falling back to a different port
# if 53000 is unavailable, so this value cannot silently go stale.
TELFLO_PUBLIC_WEB_URL=http://localhost:53000

# Mail — how outbound email leaves the API. The API depends only on an IMailer
# interface; this setting picks the implementation.
#   smtp      Mailpit in development; the customer's own relay on-prem
#   sendgrid  the hosted SaaS, via SendGrid's HTTP API
# Only the chosen transport's variables are required.
TELFLO_MAIL_TRANSPORT=smtp
TELFLO_MAIL_FROM=no-reply@telflo.local

# smtp — defaults target the Mailpit container from docker-compose.yml.
# Port 51025 matches docker-compose.yml's host mapping; see the database
# comment above for why this differs from CI's standard 1025.
TELFLO_SMTP_HOST=localhost
TELFLO_SMTP_PORT=51025
# How the connection is protected: starttls (the default: upgrade, and refuse
# a relay that can't), implicit (TLS from the start, port 465's) or none
# (plain SMTP). Mailpit takes plain SMTP, so development sets none.
# Development only (local Mailpit): production uses starttls or implicit.
TELFLO_SMTP_TLS=none
# Plain SMTP is refused to any host other than localhost unless this is
# exactly "true". Only for a development relay such as Mailpit reached by
# another hostname (the container stack sets it).
# TELFLO_SMTP_ALLOW_INSECURE=false
# The relay's login: both or neither (Mailpit needs none).
# TELFLO_SMTP_USERNAME=
# TELFLO_SMTP_PASSWORD=
# A PEM file of the CA certificates this connection alone trusts (a private
# relay's), in place of the system's: bare PEM certificate blocks only, an
# absolute path, read at start.
# TELFLO_SMTP_CA_FILE=

# sendgrid — needs a key with Mail Send permission, and TELFLO_MAIL_FROM must
# be a verified Sender Identity in that SendGrid account.
# TELFLO_SENDGRID_API_KEY=

# The site's switches and links, read by the API and the web server alike (put
# the same values in apps/web/.env). Unset, each is the open source's default,
# as below.
#   TELFLO_REGISTRATION        open, invite-only (the default) or closed
#   TELFLO_PLAYGROUND          the playground's pages; needs the next two true
#   TELFLO_ANONYMOUS_VALIDATE  validating without signing in
#   TELFLO_PUBLIC_FLOWS        the flow showcase and published flows without signing in
#   TELFLO_SALES_INQUIRY       the sales inquiry route; needs TELFLO_SALES_INQUIRY_TO
#   TELFLO_EMAIL_NOTIFICATIONS Settings › Notifications (off: no nav item, its page a 404)
#   TELFLO_DOCS_URL            the docs links (empty hides them)
#   TELFLO_TERMS_VERSION       the Terms every user accepts (empty: none);
#                              needs TELFLO_TERMS_URL and TELFLO_PRIVACY_URL
# URLs are https URLs or paths starting with /.
# TELFLO_REGISTRATION=invite-only
# TELFLO_PLAYGROUND=false
# TELFLO_ANONYMOUS_VALIDATE=false
# TELFLO_PUBLIC_FLOWS=false
# TELFLO_SALES_INQUIRY=false
# TELFLO_EMAIL_NOTIFICATIONS=false
# TELFLO_DOCS_URL=https://docs.telflo.com/
# TELFLO_TERMS_VERSION=
# TELFLO_TERMS_URL=
# TELFLO_PRIVACY_URL=
# TELFLO_COOKIE_POLICY_URL=

# Where the sales inquiries go: required while TELFLO_SALES_INQUIRY is true;
# there is no default address. One address; anything else refuses to start.
# TELFLO_SALES_INQUIRY_TO=

# Verification token lifetime, in hours.
TELFLO_VERIFICATION_TOKEN_TTL_HOURS=24

# CORS: the exact browser origin the API allows to make credentialed
# requests (Access-Control-Allow-Origin cannot be a wildcard alongside
# credentials: "include", which api-client.ts sends). Optional — defaults to
# TELFLO_PUBLIC_WEB_URL above, which is correct whenever the web app is
# served from the same origin it links back to. Set this separately only
# when those two diverge, e.g. a proxy or CDN in front of the web app.
# TELFLO_WEB_ORIGIN=http://localhost:53000

# Sessions.
# Signs session access tokens (HS256). At least 32 bytes, or the API refuses
# to start. DEVELOPMENT ONLY: this value is public in the repository. Every
# real deployment must generate its own, e.g. `openssl rand -base64 48`.
TELFLO_ACCESS_TOKEN_SECRET=development-only-access-token-secret-not-for-production
# Access token lifetime in minutes, 1 to 15.
# TELFLO_ACCESS_TOKEN_TTL_MINUTES=15
# Refresh token lifetime in days, counted from its most recent rotation.
# TELFLO_REFRESH_TOKEN_TTL_DAYS=30
# Session cookies are Secure by default (true). Local development turns that
# off: Safari/WebKit refuses Secure cookies on http://localhost (Chrome and
# Firefox allow them). Real deployments are HTTPS and keep the default true;
# the API refuses "false" unless TELFLO_PUBLIC_WEB_URL is a loopback http URL
# (localhost, 127.0.0.1 or [::1]).
TELFLO_COOKIE_SECURE=false
# How many reverse proxies in front of the API to trust for the client
# address. 0 when the API is reached directly. Never more than the number of
# proxies actually in front of it, or clients can spoof their address.
# TELFLO_TRUST_PROXY_HOPS=0

# Sign in with Google. Optional: with neither the client ID nor the secret
# set, Google is off and its buttons don't render; setting only one refuses to
# start. Create a Google "Web application" OAuth client and register the
# redirect URI ${TELFLO_PUBLIC_WEB_URL}/api/v1/auth/oidc/google/callback
# (http://localhost:53000/... here; http://localhost:50080/... for the
# container stack). Never commit a real secret.
# TELFLO_OIDC_GOOGLE_CLIENT_ID=
# TELFLO_OIDC_GOOGLE_CLIENT_SECRET=
# The issuer, https://accounts.google.com by default. Only tests change it, to
# a local fake provider; an http issuer is refused unless it is on localhost,
# 127.0.0.1 or [::1]. Google's email rule (Gmail addresses and Workspace hd)
# applies only to https://accounts.google.com exactly, or a loopback http
# fake; any other issuer here links, takes over or creates no account.
# TELFLO_OIDC_GOOGLE_ISSUER=https://accounts.google.com

# The opamp-server's management API (required): the API refuses to start
# without both. It publishes configurations there, and registers each
# organization it creates, renames or deletes there after the response, only
# logging a warning when the server can't be reached (a publish registers any
# it missed). `npm run dev:services` starts it (opamp-server, after its
# bootstrap and migrations) on the host's 127.0.0.1:51235, which the values
# below name. The URL is http or https; the secret is the opamp-server's
# OPAMP_MANAGEMENT_SECRET, at least 32 bytes, and is never logged. The
# container stack sets both (the API reaches the server as opamp-server). The
# secret below is the stack's development-only value, public in the
# repository: every real deployment generates its own, e.g.
# `openssl rand -base64 48`.
TELFLO_OPAMP_MANAGEMENT_URL=http://127.0.0.1:51235
TELFLO_OPAMP_MANAGEMENT_SECRET=development-only-opamp-management-secret-not-for-production
# A server across a network you don't trust: https, when the opamp-server
# has OPAMP_MANAGEMENT_TLS_CERT_FILE and _KEY_FILE set (or sits behind a
# TLS-terminating proxy), so the secret never crosses it in the clear.
# TELFLO_OPAMP_MANAGEMENT_URL=https://opamp-management.internal:51235
# A certificate from your own CA: Node's standard variable adds that CA (a
# PEM file) to the ones Node trusts. Node reads it only as it starts, before
# the API loads this file, so set it in the shell or the container instead.
# NODE_EXTRA_CA_CERTS=/path/to/internal-ca.pem

# The collector validator (required): the API refuses to start without both.
# The editor's checks go through the API to it; when it can't be reached, a
# check answers "unavailable" and nothing else breaks. `npm run dev:services`
# starts it (otelcol-validator) on the host's 127.0.0.1:51236, which the
# values below name. The URL is http or https; the secret is the validator's
# OTELCOL_VALIDATOR_SECRET, at least 32 bytes, and is never logged. The
# container stack sets both (the API reaches it as otelcol-validator:8001).
# The secret below is the stack's development-only value, public in the
# repository: every real deployment generates its own, e.g.
# `openssl rand -base64 48`.
TELFLO_OTELCOL_VALIDATOR_URL=http://127.0.0.1:51236
TELFLO_OTELCOL_VALIDATOR_SECRET=development-only-otelcol-validator-secret-not-for-production

# The collector tester (required): the API refuses to start without both. Test
# runs are sent to it; when it can't be reached, testing refuses new runs
# ("Testing is unavailable right now") and nothing else breaks.
# `npm run dev:services` starts it (otelcol-testing), with its forwarder on
# the host's 127.0.0.1:51237, which the URL below names: the tester sits on a
# network with no way out, so only the forwarder publishes it. The URL is http
# or https; the secret is the text of the tester's secret file
# (docker/otelcol-testing/development-secret), at least 32 bytes, and is never
# logged. The container stack sets both (the API reaches it as
# otelcol-testing:8002). The secret below is the stack's development-only
# value, public in the repository: every real deployment generates its own,
# e.g. `openssl rand -base64 48`.
TELFLO_OTELCOL_TESTING_URL=http://127.0.0.1:51237
TELFLO_OTELCOL_TESTING_SECRET=development-only-otelcol-testing-secret-not-for-production
# Optional: at most this many runs at once across the API's processes
# (default 4, the tester's own cap; 1 to 64), and how long the tester may be down
# before waiting runs fail (default 600 seconds; at most 86400).
# TELFLO_TEST_RUNS_PER_TESTER=4
# TELFLO_TESTING_DOWN_FAIL_AFTER_SECONDS=600

# The OTTL evaluator (required): the API refuses to start without both.
# It checks a test run's validation rules when the run ends, and a rule when
# it is saved; when it can't be reached, saving a rule that needs checking is
# refused and runs with rules end Error, and nothing else breaks.
# `npm run dev:services` starts it (ottl-evaluator), with its own
# forwarder on the host's 127.0.0.1:51238, which the URL below names: the
# evaluator sits on its own network with no way out, so only the forwarder
# publishes it. The URL is http or https; the secret is the text of the
# evaluator's secret file (docker/ottl-evaluator/development-secret), at
# least 32 bytes, and is never logged. The container stack sets both (the API
# reaches it as ottl-evaluator:8003). The secret below is the stack's
# development-only value, public in the repository: every real deployment
# generates its own, e.g. `openssl rand -base64 48`.
TELFLO_OTTL_EVALUATOR_URL=http://127.0.0.1:51238
TELFLO_OTTL_EVALUATOR_SECRET=development-only-ottl-evaluator-secret-not-for-production

# The file store: where test inputs and runs' files are kept, by ids only. Its
# kind, TELFLO_FILE_STORE, is local (the default, when unset or empty) or s3;
# anything else refuses to start. Only the chosen kind's settings are read:
# the local disk ignores the S3 ones, and S3 ignores the root, so both may be
# set at once (the container stack sets both). Switching kind moves no file:
# copy them across first.
# TELFLO_FILE_STORE=local
#
# local: files under this directory. An absolute path (a relative one, or ~,
# refuses to start) to a directory that exists and that the API can write:
# it checks both as it starts, and refuses otherwise. Create it first, e.g.
# `mkdir -p /var/tmp/telflo/file-store`, or point it at a directory of your
# own such as /Users/<you>/.telflo/file-store. The container stack sets it
# to its own volume (file-store). Nothing prunes it yet.
TELFLO_FILE_STORE_ROOT=/var/tmp/telflo/file-store
#
# s3: objects in one bucket of AWS S3 or another S3-protocol server. As it
# starts, the API writes an empty probe there, asks for a different name
# that doesn't exist (which must answer "not found", and on AWS that needs
# s3:ListBucket on the bucket), then removes the probe, and refuses to
# start unless each step works. The bucket (required) is an S3 bucket
# name: 3 to 63 lower-case letters, digits, dots and hyphens, a letter or
# digit at each end, no "..". The prefix (optional; none by default) keeps
# installs sharing a bucket apart: segments of lower-case letters, digits
# and ._- separated by /, each beginning with a letter or digit, at most 256
# characters with its trailing / (acme and acme/ are the same prefix). The
# region (required) is 1 to 32 lower-case letters, digits and hyphens. The
# endpoint (optional) is for a server other than AWS: a lower-case http or
# https scheme, a host (an internationalized one in its xn-- form) or a
# bracketed IPv6 address, an optional port from 1 to 65535 and an optional
# /, nothing else (no user name, password, path, query or fragment); unset,
# AWS's own endpoint for the region. Its refusal names the variable and the
# rule, never the value, which may hold a credential. Use https for any
# server off the machine: over plain http the files and the signed requests
# travel in clear. Path style ("true" or "false", default false) names the
# bucket in the URL's path rather than its host, as SeaweedFS and MinIO
# need. None of these is a secret.
# TELFLO_FILE_STORE_BUCKET=telflo-files
# TELFLO_FILE_STORE_PREFIX=
# TELFLO_FILE_STORE_S3_REGION=us-east-1
# TELFLO_FILE_STORE_S3_ENDPOINT=http://127.0.0.1:51240
# TELFLO_FILE_STORE_S3_FORCE_PATH_STYLE=true
#
# S3's keys are never Telflo settings: the AWS SDK finds them itself, by its
# default chain (on EKS, the pod's IAM role; elsewhere, the standard
# AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY variables, or ~/.aws), and the
# API never reads, logs or shows them. To run the API natively against
# `npm run dev:services`' object store, export the development-only keys
# below as AWS_ACCESS_KEY_ID and AWS_SECRET_ACCESS_KEY in that shell only.
# Never put real keys in this file.

# The object store's test server (the API's S3 tests): the container
# `npm run dev:services` starts (object-store, a local SeaweedFS, on the
# host's 127.0.0.1:51240), which the tests make their own bucket in. The keys
# are its development-only admin identity, docker-compose.yml's values, public
# in the repository: they unlock only that local container, never a real
# bucket. The tests hand them to the S3 client through the SDK's own chain and
# never print them.
TELFLO_TEST_S3_ENDPOINT=http://127.0.0.1:51240
TELFLO_TEST_S3_ACCESS_KEY_ID=telflo-development-only-object-store-key
TELFLO_TEST_S3_SECRET_ACCESS_KEY=telflo-development-only-object-store-secret-not-for-production

# Installing collectors. The agent endpoint (required) is written into the
# install dialog's commands and the Linux bundles: the address the collectors
# connect to, the same as the opamp-server's OPAMP_SERVER_URL.
# `npm run dev:services` gives the opamp-server compose's default, below:
# host.docker.internal reaches the host's published agent port from a
# collector's container (127.0.0.1 would be the container's own loopback). An
# http, https, ws or wss URL with a host, an optional port and a plain path
# (no user name, query or fragment). Development's is plain http, so insecure
# connections are allowed here; a real deployment's is https and keeps the
# default, false.
TELFLO_OPAMP_AGENT_PUBLIC_URL=http://host.docker.internal:51234/opamp/api/v1
TELFLO_OPAMP_ALLOW_INSECURE_CONNECTIONS=true
# The container install's image, tagged by the group's published version's
# collector version (default ghcr.io/telflo/telflo/collector, the
# platform's own image; a mirror's in an air-gapped network).
# TELFLO_COLLECTOR_IMAGE_REPOSITORY=ghcr.io/telflo/telflo/collector
# The Helm chart a Kubernetes-supervisor fleet's groups install with (default
# the platform's own published chart, charts/supervisor-collector, and its
# version; a mirror's in an air-gapped network). An oci:// reference of
# lowercase letters, digits and ._:/-, and an exact x.y.z version.
# TELFLO_HELM_CHART_REFERENCE=oci://ghcr.io/telflo/telflo/charts/supervisor-collector
# TELFLO_HELM_CHART_VERSION=0.1.0
# The Linux bundles' templates: a directory holding linux/all-in-one/ and
# linux/own-binary/, read on every render (default
# /etc/telflo/install-templates, the API image's copy). An absolute path;
# the API refuses to start when either set can't be read. In development,
# put your checkout's absolute path to the repository's install-templates/
# here (replace /path/to/telflo), or an operator's directory such
# as a Kubernetes ConfigMap or a minikube hostPath.
TELFLO_INSTALL_TEMPLATES_DIR=/path/to/telflo/install-templates

# Quick-deploy links (both required). The API's base URL as a host running a
# Quick Deploy command reaches it: a link is
# {TELFLO_PUBLIC_API_URL}/api/v1/quick-deploy/{secret}. Below, the dev API on
# port 8080 as a collector's container on this machine reaches it
# (host.docker.internal; 127.0.0.1 would be the container's own loopback); a
# VM on your network uses this machine's LAN address. http or https, a host,
# an optional port and a plain path (no user name, query, fragment or %); a
# trailing / is removed. An IPv6 address goes in brackets, and only an IPv6
# address may: http://[fd00::10]:8080 (http://[abc]:8080 is refused). The
# container stack sets its gateway's, http://host.docker.internal:50080.
TELFLO_PUBLIC_API_URL=http://host.docker.internal:8080
# The key that seals (AES-256-GCM) the values typed for a link's variables:
# 32 bytes in base64. The value below is the stack's development-only value,
# public in the repository: every real deployment generates its own, e.g.
# `openssl rand -base64 32`, and never logs it. After a rotation, the old
# keys go in TELFLO_QUICK_DEPLOY_PREVIOUS_ENCRYPTION_KEYS (comma separated,
# at most 8) until the links they sealed are gone.
TELFLO_QUICK_DEPLOY_ENCRYPTION_KEY=ZGV2ZWxvcG1lbnQtb25seS1xZC1rZXktbm90LXByb2Q=
# TELFLO_QUICK_DEPLOY_PREVIOUS_ENCRYPTION_KEYS=

# The library's Copy curl links (the key required). The key that signs a link
# (HMAC-SHA256): at least 32 bytes, trimmed. The value below is the stack's
# development-only value, public in the repository: every real deployment
# generates its own, e.g. `openssl rand -base64 32`, and never logs it. A link
# lives 24 hours; after a rotation, the old keys go in
# TELFLO_LIBRARY_LINK_SIGNING_KEYS_PREVIOUS (comma separated, at most 8, each
# at least 32 bytes) for a day, until the links they signed have expired.
TELFLO_LIBRARY_LINK_SIGNING_KEY=telflo-development-only-library-link-signing-key
# TELFLO_LIBRARY_LINK_SIGNING_KEYS_PREVIOUS=

# Web server (apps/web). In development it reads apps/web/.env, not this
# file: React Router's Vite plugin loads it, and the shell's environment wins
# over it. Put the web's settings there, and restart Vite after changing
# them. The container stack sets them in docker-compose.yml.
#
# Canonical links, og:url, JSON-LD URLs, robots.txt's Sitemap line and the
# sitemap follow TELFLO_PUBLIC_WEB_URL, the same setting as the API's above.
# Unset or empty, pages leave them out.
# TELFLO_PUBLIC_WEB_URL=http://localhost:53000
# Where server loaders reach the API.
# TELFLO_API_INTERNAL_URL=http://localhost:8080
#
# Product analytics: PostHog, off unless a key is set. Unset or empty,
# posthog-js is never loaded and no cookie banner shows: the on-prem and
# air-gapped default. With a key, the browser loads posthog-js, which captures
# nothing until the visitor accepts the banner. The host is optional; unset,
# it is posthog-js's own default.
# TELFLO_POSTHOG_KEY=
# TELFLO_POSTHOG_HOST=https://us.i.posthog.com
