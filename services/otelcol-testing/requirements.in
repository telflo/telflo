# The tester's runtime dependencies. The lock, requirements.txt, is made from
# this file with
#   pip-compile --generate-hashes --allow-unsafe --strip-extras \
#     --output-file=requirements.txt requirements.in
# and installed with `pip install --require-hashes -r requirements.txt`.
#
# Every package both services ship is pinned as the validator pins it.
-c ../otelcol-validator/requirements.txt
fastapi
# Plain uvicorn (no [standard]): no uvloop, httptools or watchfiles.
uvicorn
pyyaml
# The mutations edit the text with ruamel.yaml, pinned.
ruamel.yaml==0.18.6
# OTLP replay's client. Not httpx: it brings certifi, MPL-2.0, which
# fails the license check. httpx2 is BSD-3-Clause.
httpx2

# The service's own telemetry (telemetry.py), inert unless
# OTEL_EXPORTER_OTLP_ENDPOINT is set. OTLP over gRPC.
opentelemetry-sdk
opentelemetry-exporter-otlp-proto-grpc
opentelemetry-instrumentation-fastapi
opentelemetry-instrumentation-logging
opentelemetry-instrumentation-system-metrics
