# Breaks one rule: finalize.yml publishing the Release before a later step.
file: finalize.yml
rule: required-steps
<<<
        run: bash scripts/release/steps.sh finalize-publish --version "$VERSION" --digests "$RUNNER_TEMP/finalize/digests.txt"
===
        run: bash scripts/release/steps.sh finalize-publish --version "$VERSION" --digests "$RUNNER_TEMP/finalize/digests.txt"
      - env:
          DOCKER_CONFIG: ${{ runner.temp }}/docker
          HELM_REGISTRY_CONFIG: ${{ runner.temp }}/helm/registry/config.json
        run: bash scripts/release/verify-collector-artifacts.sh
>>>
