# Breaks one rule: a repository secret in a job's env.
file: ci.yml
rule: ci-secrets
<<<
      TELFLO_TEST_S3_SECRET_ACCESS_KEY: telflo-development-only-object-store-secret-not-for-production
      SHARD: ${{ matrix.shard }}
===
      TELFLO_TEST_S3_SECRET_ACCESS_KEY: telflo-development-only-object-store-secret-not-for-production
      SHARD: ${{ matrix.shard }}
      CODECOV_TOKEN: ${{ secrets.CODECOV_TOKEN }}
>>>
