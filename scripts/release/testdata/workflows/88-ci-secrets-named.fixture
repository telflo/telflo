# Breaks one rule: a repository secret in a job's env.
file: ci.yml
rule: ci-secrets
<<<
      TELFLO_ACCESS_TOKEN_SECRET: ci-only-access-token-secret-not-for-production
      SHARD: ${{ matrix.shard }}
===
      TELFLO_ACCESS_TOKEN_SECRET: ci-only-access-token-secret-not-for-production
      SHARD: ${{ matrix.shard }}
      CODECOV_TOKEN: ${{ secrets.CODECOV_TOKEN }}
>>>
