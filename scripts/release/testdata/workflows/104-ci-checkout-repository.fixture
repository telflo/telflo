# Breaks one rule: a checkout of another repository.
file: ci.yml
rule: ci-checkout-keys
<<<
          persist-credentials: false
      - run: bash scripts/release/tools.sh fetch gitleaks
      - run: bash scripts/release/check-secrets.sh
===
          persist-credentials: false
          repository: someone/telflo-fork
      - run: bash scripts/release/tools.sh fetch gitleaks
      - run: bash scripts/release/check-secrets.sh
>>>
