# Breaks one rule: a job with service containers (services:).
file: release.yml
rule: job-keys
<<<
  kind-smoke:
    needs: [version, build, package]
    runs-on: ubuntu-24.04
===
  kind-smoke:
    needs: [version, build, package]
    services:
      helper:
        image: alpine:3.20
    runs-on: ubuntu-24.04
>>>
