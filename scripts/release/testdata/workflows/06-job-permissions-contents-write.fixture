# Breaks one rule: a build job asking for contents: write.
file: release.yml
rule: job-permissions
<<<
  build:
    needs: version
    runs-on: ubuntu-24.04
    timeout-minutes: 150
    permissions:
      contents: read

===
  build:
    needs: version
    runs-on: ubuntu-24.04
    timeout-minutes: 150
    permissions:
      contents: write

>>>
