# Breaks one rule: the required archive-smoke step kept, and an extra step calling the smoke
# directly (its output not through redact.sh).
file: release.yml
rule: smoke-direct
<<<
        run: bash scripts/release/steps.sh archive-smoke --version "$VERSION" --release "$RUNNER_TEMP/release" --work "$RUNNER_TEMP/archive-smoke"
===
        run: bash scripts/release/steps.sh archive-smoke --version "$VERSION" --release "$RUNNER_TEMP/release" --work "$RUNNER_TEMP/archive-smoke"
      - name: The archive smoke again
        env:
          VERSION: ${{ needs.version.outputs.version }}
        run: bash scripts/smoke-compose-install.sh --archive "$RUNNER_TEMP/release/telflo-compose-$VERSION.tar.gz" --sums "$RUNNER_TEMP/release/SHA256SUMS" --work "$RUNNER_TEMP/archive-smoke2"
>>>
