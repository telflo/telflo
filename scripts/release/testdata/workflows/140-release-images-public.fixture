file: release.yml
rule: required-steps
<<<
run: bash scripts/publish-platform-images.sh --push-oci "$RUNNER_TEMP/oci" --namespace telflo-staging
===
run: bash scripts/publish-platform-images.sh --push-oci "$RUNNER_TEMP/oci"
