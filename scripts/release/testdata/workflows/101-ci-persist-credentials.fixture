# Breaks one rule: a checkout that keeps its token in .git/config.
file: ci.yml
rule: ci-persist-credentials
<<<
          persist-credentials: false
      - run: bash scripts/release/tools.sh fetch gitleaks
      - run: bash scripts/release/check-secrets.sh
===
          persist-credentials: true
      - run: bash scripts/release/tools.sh fetch gitleaks
      - run: bash scripts/release/check-secrets.sh
>>>
