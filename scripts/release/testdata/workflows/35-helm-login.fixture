# Breaks one rule: a chart push without HELM_REGISTRY_CONFIG.
file: release.yml
rule: helm-login
<<<
      - name: The chart (the packaged file)
        env:
          DOCKER_CONFIG: ${{ runner.temp }}/docker
          HELM_REGISTRY_CONFIG: ${{ runner.temp }}/helm/registry/config.json

===
      - name: The chart (the packaged file)
        env:
          DOCKER_CONFIG: ${{ runner.temp }}/docker

>>>
