# Breaks one rule: the two test jobs' Postgres image shared by an anchor and an alias.
file: ci.yml
rule: yaml
<<<
        shard: [1, 2, 3, 4]
    services:
      postgres:
        image: postgres:18@sha256:9f4fd4aa918f52ae3d6f3b687f1de90d8f867cd4d520021545a9a50c120eae3b
===
        shard: [1, 2, 3, 4]
    services:
      postgres:
        image: &postgres postgres:18@sha256:9f4fd4aa918f52ae3d6f3b687f1de90d8f867cd4d520021545a9a50c120eae3b
>>>
<<<
        shard: [1, 2]
    services:
      postgres:
        image: postgres:18@sha256:9f4fd4aa918f52ae3d6f3b687f1de90d8f867cd4d520021545a9a50c120eae3b
===
        shard: [1, 2]
    services:
      postgres:
        image: *postgres
>>>
